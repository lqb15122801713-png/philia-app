# ============================================================================
# Philia 环境变量清单（批次 6 · 任务 B3）
# 用法：cp .env.example .env 后逐项填真值。.env 已在 .gitignore，真值永不入库。
# 每行变量均已与代码读取位置逐一核对（server 运行时读 process.env；
# 仅 VITE_API_BASE 为三端 vite 构建期变量）。
# ============================================================================

# ---- 运行环境 --------------------------------------------------------------
# 批次 6 产品侧裁定书 #1 ②：VPS 内测必须 NODE_ENV=staging —— staging 合法放行
# MockPayProvider（payments/provider.ts），secrets/deploy 闸门不触发但显式注入
# 的变量照常生效；NODE_ENV=production 时启用全部启动闸门（secrets / 部署配置 /
# 支付配置任一缺失即拒绝启动），且 production + mock 红线不变（§4.7）
NODE_ENV=staging

# ---- 服务端口 ----------------------------------------------------------------
# server 监听端口（server/src/index.ts；缺省 7200，docker-compose 内网保持 7200 即可）
PORT=7200

# ---- 静态托管（批次 6 任务 A · 方案一 Host 头分发，容器内默认已开） -----------
# SERVE_STATIC=1 开启三端静态托管（server/src/static/spa.ts；未设置=关，dev 不变）：
# 按 Host 子域分发 app.*→customer / m.*→merchant / s.*→staff，无子域/裸 IP 兜底 customer
SERVE_STATIC=1
# 三端 dist 所在 apps 父目录（容器内 /app/apps；本地直跑时设为仓库 apps 绝对路径）
STATIC_ROOT=/app/apps

# ---- 数据库（libsql 嵌入式，不迁移） ----------------------------------------
# libsql 连接串；缺省为 server/data/philia.db（server/src/db/index.ts）
# 生产填 file: 绝对路径，指向 compose volume 挂盘点，如 file:/data/philia.db
PHILIA_DB_URL=file:/app/data/philia.db

# ---- HMAC 密钥（production 必须显式注入强随机值，缺省/仍为 dev 值即拒绝启动） --
# 会话 cookie 签名（server/src/auth/session.ts）
SESSION_SECRET=
# 核销二维码签名（server/src/routers/appointment.ts）
BOOKING_CODE_SECRET=
# 签名图片 URL（server/src/storage/sign.ts）
IMG_SECRET=

# ---- 部署配置（production 必须显式配置，缺失即拒绝启动，见 config/deploy.ts） --
# CORS 跨域白名单，逗号分隔完整 origin（server/src/config/deploy.ts → index.ts cors）
# 方案一 Host 分发下填三子域，如 https://app.example.com,https://m.example.com,https://s.example.com
CORS_ORIGINS=https://app.example.com,https://m.example.com,https://s.example.com
# 公共 base URL（server/src/config/deploy.ts；部署手册/冒烟脚本/反代对齐用）
PUBLIC_BASE_URL=https://app.example.com
# 内测口令门（批次 6 拍板 2）：设置后 dev-login / dev-seed-users 须携带正确口令，
# 缺失 401 / 错误 403（server/src/auth/devLogin.ts）；production 未设置拒绝启动；
# staging 未设置仅告警（warnStagingConfig）——内测机务必设置
BETA_GATE_CODE=

# ---- 三端域名（仅 compose 可选 https profile 使用，server 运行时不读） --------
# Caddy 反代三子域（docker-compose.yml / caddy/Caddyfile；Host 头透传 → 方案一分发）
APP_DOMAIN=app.example.com
M_DOMAIN=m.example.com
S_DOMAIN=s.example.com

# ---- 支付（批次 6 拍板 3 + 裁定书 #1 ②：内测走 MockPayProvider，不接微信真配置） --
# mock | wechat（server/src/payments/provider.ts；缺省 mock。
# 内测口径：NODE_ENV=staging + mock 合法放行；NODE_ENV=production + mock 仍
# 触发 §4.7 红线拒绝启动（一行未动））
PAYMENT_PROVIDER=mock
# mock 回调 HMAC 密钥（server/src/payments/mockPay.ts；仅 mock 模式使用）
MOCK_PAY_SECRET=
# 微信支付配置（server/src/payments/wechatPay.ts；仅 PAYMENT_PROVIDER=wechat 时
# 强制校验，缺一即拒绝启动。本批次不接真配置，留空即可）
WECHAT_MCHID=
WECHAT_APPID=
WECHAT_KEY=
WECHAT_SERIAL=

# ---- 三端构建期（vite build 时注入，非 server 运行时） -----------------------
# 三端 PWA 的 API base（packages/shared/src/api/client.ts getApiBase；
# 缺省 http://localhost:7200。同源部署填公共域名或留空走缺省，按任务 A 分发方案定）
VITE_API_BASE=
